---
import BaseLayout from '../../layouts/BaseLayout.astro';

const jobs = [
  {
    company: 'Capital One',
    location: 'Wilmington, DE',
    title: 'Senior Data Engineer',
    range: 'Apr 2025 – Present',
    highlights: [
      'Designed and implemented scalable data platform enhancements supporting enterprise-level Capital One/Discover data migrations across multiple systems.',
      'Performed benchmark analysis to identify performance bottlenecks and delivered optimizations that reduced ETL processing time by 95% while increasing supported file sizes by 10×.',
      'Selected and leveraged an existing enterprise data quality platform to validate and cleanse incoming Discover datasets, reducing downstream operational toil and reprocessing during migration efforts.',
      'Architected a GenAI-powered schema mapping assistant using LLM prompting workflows, reducing manual data onboarding efforts and earning top-3 recognition across 110 teams in a hackathon.',
      'Strengthened application security by modernizing legacy code paths and ensuring compliance with Capital One security controls.',
      'Championed enterprise standards adoption, lowering future maintenance costs.',
    ],
    skills: ['Python', 'PySpark', 'SQL', 'AWS', 'ETL', 'GenAI / LLMs', 'Data Quality', 'Data Migration']
  },
  {
    company: 'JPMorgan Chase',
    location: 'Wilmington, DE',
    title: 'Data Engineer',
    range: 'Nov 2023 – Apr 2025',
    highlights: [
      'Designed and migrated legacy ETL pipelines to the cloud using Amazon EMR clusters, leveraging PySpark to enhance performance.',
      'Optimized and refactored our legacy Scala codebase over to Python, improving efficiency and maintainability, resulting in a 60% reduction in runtime.',
      'Led the development of a new data ingestion pipeline, enabling the first adoption of Databricks UniForm data in the cloud within the organization.',
      'Worked with cross-functional teams to implement shared logic for data processing, enabling a standardized solution across teams and improving overall developer efficiency.',
      'Facilitated knowledge transfer sessions on our cloud-based solutions for downstream teams, enabling faster delivery of their own solutions.',
    ],
    skills: ['Python', 'PySpark', 'Scala', 'Amazon EMR', 'Databricks', 'SQL', 'AWS', 'ETL']
  },
  {
    company: 'The Vanguard Group',
    location: 'Malvern, PA',
    title: 'Application Engineer',
    range: 'April 2021 – June 2023',
    highlights: [
      'Acted as the primary product owner for our Payment Request Form application which processes invoices exceeding a million dollars and resides on Oracle\'s Visual Builder platform.',
      'Led a team of 4 developers in a modernization initiative to transition our Oracle integrations (OIC) to AWS.',
      'Used Python to mass update contracts, purchase orders and other types of financial documents saving our clients over 100+ hours.',
      'Maintained quality of staging environments including the automation of realistic data syncing from production environments using Java Selenium.',
      'Supported production issues, coordinating with banks and other vendors to resolve issues and implement enhancements.',
      'Achieved Security Champion 2 by taking company provided application security courses and being shadowed during SARs (Security Assessment Reviews).',
    ],
    skills: ['Python', 'Java', 'Selenium', 'Oracle Visual Builder', 'Oracle OIC', 'AWS']
  },
];
---

<BaseLayout title="Experience — Matthew Spencer" description="My professional journey as a developer.">
  <div class="max-w-4xl mx-auto px-6 py-16">

    <!-- Header -->
    <div class="mb-12">
      <p class="text-xs font-mono uppercase tracking-widest text-accent-400 mb-2">Career</p>
      <h1 class="text-4xl font-bold text-white mb-3">Professional Journey</h1>
      <p class="text-gray-400">My experience and growth as a developer.</p>
    </div>

    <!-- Job entries -->
    <div class="flex flex-col gap-6">
      {jobs.map(job => (
        <div class="rounded-xl border border-gray-800 bg-gray-900 p-6">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-4">
            <div>
              <h2 class="text-lg font-semibold text-white">{job.company}</h2>
              <p class="text-accent-400 text-sm">{job.title}</p>
              <p class="text-gray-500 text-xs mt-0.5">{job.location}</p>
            </div>
            <span class="text-sm text-gray-500 font-mono whitespace-nowrap">{job.range}</span>
          </div>
          <ul class="flex flex-col gap-2 mb-5">
            {job.highlights.map(point => (
              <li class="flex items-start gap-2 text-sm text-gray-400">
                <span class="text-accent-400 shrink-0 mt-0.5">▹</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-gray-800">
            {job.skills.map(skill => (
              <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</BaseLayout>
