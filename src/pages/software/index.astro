---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import { softwareProjects } from '../../data/software-projects';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const published = softwareProjects
  .filter((p) => p.published)
  .sort((a, b) => a.order - b.order);
---

<BaseLayout title="Software Projects — Matthew Spencer" description="A gallery of my software development work.">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <div class="mb-12">
      <p class="text-xs font-mono uppercase tracking-widest text-accent-400 mb-2">Portfolio</p>
      <h1 class="text-4xl font-bold text-white mb-3">Featured Projects</h1>
      <p class="text-gray-400">Apps, tools, and experiments I've built.</p>
    </div>

    {published.length === 0 ? (
      <p class="text-gray-500">No projects yet — check back soon.</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {published.map((project) => (
          <ProjectCard
            project={project}
            href={project.liveUrl ?? `${base}software/${project.slug}/`}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
