---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const navLinks = [
  { label: 'Home',              href: base                    },
  { label: 'Software Projects', href: `${base}software/`     },
  { label: 'Game Dev Projects', href: `${base}gamedev/`      },
  { label: 'Experience',        href: `${base}experience/`   },
  { label: 'Contact',           href: `${base}contact/`      },
];
---

<header class="sticky top-0 z-50 bg-gray-950/80 backdrop-blur">
  <nav class="h-14 flex items-center justify-center px-4">
    <ul class="flex items-center gap-1">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="px-3 py-1.5 rounded-md text-sm text-gray-300 hover:text-white hover:bg-gray-800 transition-colors"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
