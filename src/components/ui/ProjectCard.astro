---
import type { Project } from '../../types/project';

interface Props {
  project: Project;
  href?: string;
}

const { project, href } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const isExternal = href?.startsWith('http') ?? false;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  {...isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  class={`group block rounded-xl overflow-hidden border border-gray-800 bg-gray-900 transition-all duration-200 ${href ? 'hover:border-accent-600 hover:shadow-lg hover:shadow-accent-900/20 cursor-pointer' : 'cursor-default'}`}
>
  <!-- GIF preview -->
  <div class="aspect-video overflow-hidden bg-gray-800">
    <img
      src={`${base}${project.previewGif}`}
      alt={`${project.title} preview`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
  </div>

  <!-- Card body -->
  <div class="p-5">
    <div class="flex items-baseline justify-between gap-2 mb-1">
      <h3 class="font-semibold text-white group-hover:text-accent-300 transition-colors">
        {project.title}
      </h3>
      {project.year && <span class="text-xs text-gray-500 font-mono shrink-0">{project.year}</span>}
    </div>
    <p class="text-sm text-gray-400 mb-4 line-clamp-2">{project.tagline}</p>

    <!-- Tech tags -->
    <div class="flex flex-wrap gap-1.5">
      {project.techStack.slice(0, 4).map((tech) => (
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-gray-800 text-gray-400 border border-gray-700">
          {tech}
        </span>
      ))}
      {project.techStack.length > 4 && (
        <span class="px-2 py-0.5 rounded text-xs font-mono text-gray-500">
          +{project.techStack.length - 4}
        </span>
      )}
    </div>
  </div>
</Tag>
