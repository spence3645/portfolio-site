---
import type { Project } from '../../types/project';

interface Props {
  project: Project;
  href?: string;
}

const { project, href } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const isExternal = href?.startsWith('http') ?? false;
---

<div class={`group relative rounded-xl overflow-hidden border border-gray-800 bg-gray-900 transition-all duration-200 ${href ? 'hover:border-accent-600 hover:shadow-lg hover:shadow-accent-900/20' : ''}`}>
  {href && (
    <a
      href={href}
      {...isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
      class="absolute inset-0 z-0"
      aria-label={project.title}
    />
  )}

  <!-- GIF preview -->
  <div class="aspect-video overflow-hidden bg-gray-800">
    <img
      src={`${base}${project.previewGif}`}
      alt={`${project.title} preview`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
  </div>

  <!-- Card body -->
  <div class="p-5">
    <div class="flex items-baseline justify-between gap-2 mb-1">
      <h3 class="font-semibold text-white group-hover:text-accent-300 transition-colors">
        {project.title}
      </h3>
      {project.year && <span class="text-xs text-gray-500 font-mono shrink-0">{project.year}</span>}
    </div>
    <p class="text-sm text-gray-400 mb-4 line-clamp-2">{project.tagline}</p>

    <!-- Tech tags -->
    <div class="flex flex-wrap gap-1.5">
      {project.techStack.slice(0, 4).map((tech) => (
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-gray-800 text-gray-400 border border-gray-700">
          {tech}
        </span>
      ))}
      {project.techStack.length > 4 && (
        <span class="px-2 py-0.5 rounded text-xs font-mono text-gray-500">
          +{project.techStack.length - 4}
        </span>
      )}
    </div>
  </div>

  <!-- GitHub icon (bottom-right, above the stretched link) -->
  {project.repoUrl && (
    <a
      href={project.repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="absolute bottom-4 right-4 z-10 text-gray-500 hover:text-white transition-colors"
      aria-label={`${project.title} on GitHub`}
      onclick="event.stopPropagation()"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
      </svg>
    </a>
  )}
</div>
