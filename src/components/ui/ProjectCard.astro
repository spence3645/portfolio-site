---
import type { Project } from '../../types/project';

interface Props {
  project: Project;
  href: string;
}

const { project, href } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a
  href={href}
  class="group block rounded-xl overflow-hidden border border-gray-800 bg-gray-900 hover:border-accent-600 transition-all duration-200 hover:shadow-lg hover:shadow-accent-900/20"
>
  <!-- GIF preview -->
  <div class="aspect-video overflow-hidden bg-gray-800">
    <img
      src={`${base}${project.previewGif}`}
      alt={`${project.title} preview`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
  </div>

  <!-- Card body -->
  <div class="p-5">
    <h3 class="font-semibold text-white mb-1 group-hover:text-accent-300 transition-colors">
      {project.title}
    </h3>
    <p class="text-sm text-gray-400 mb-4 line-clamp-2">{project.tagline}</p>

    <!-- Tech tags -->
    <div class="flex flex-wrap gap-1.5">
      {project.techStack.slice(0, 4).map((tech) => (
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-gray-800 text-gray-400 border border-gray-700">
          {tech}
        </span>
      ))}
      {project.techStack.length > 4 && (
        <span class="px-2 py-0.5 rounded text-xs font-mono text-gray-500">
          +{project.techStack.length - 4}
        </span>
      )}
    </div>
  </div>
</a>
